# MAX Bot token из @MasterBot (https://dev.max.ru) — НЕ коммитить!
MAX_BOT_TOKEN=replace_me_with_real_token

# Ссылка на канал/группу в MAX, куда ведём аудиторию
CHANNEL_URL=https://max.ru/join/CHANGE_ME

# Промокоды для веток сценария
PROMO_A=ПЕДАГОГ20
PROMO_C=ПЕДАГОГ30

# Пути хранилища и файлов (относительно корня проекта)
DB_PATH=data/contacts.db
FILES_DIR=files

# Перманентные админы — только эти user_id могут использовать /export, /digest, /stats.
# Формат: "user_id:chat_id:имя, user_id:chat_id:имя"
# Узнать user_id/chat_id: пусть человек напишет боту — смотрим в bot.log строку "Обработано ... chat_id: X, user_id: Y"
ADMIN_USER_IDS=

# Часовой пояс для ежедневного дайджеста (IANA-имя)
DIGEST_TZ=Asia/Yekaterinburg
DIGEST_HOUR=8
DIGEST_MINUTE=0

